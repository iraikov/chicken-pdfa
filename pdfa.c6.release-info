;; -*- scheme -*-
(repo git "git://github.com/iraikov/chicken-pdfa.git")
(uri targz "https://github.com/iraikov/chicken-pdfa/tarball/{egg-release}")
(uri files-list "http://code.call-cc.org/files-list?egg={egg-name};egg-release={egg-release};chicken-release={chicken-release}" old-uri)

(release "1.0")

